{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -b",
    "migrate": "node --env-file-if-exists=.env src/db/migrate-cli.ts",
    "lang-check": "node --env-file-if-exists=.env scripts/lang-check.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.41",
    "@hono/node-server": "^2.1.1",
    "ai": "^7.0.85",
    "hono": "^4.13.5",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.128.0"
  }
}
