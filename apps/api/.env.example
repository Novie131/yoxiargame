# 複製成 .env 後填入。.env 已被 git 忽略，不會被提交。

# 要用哪一家：nvidia | local | anthropic
LLM_PROVIDER=nvidia

# ── NVIDIA NIM ──
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 必填，沒有預設值。去 build.nvidia.com 看目前可用的模型，
# 複製它頁面上的 model id 貼過來（形如 meta/llama-... 或 nvidia/... ）。
NVIDIA_MODEL=

# 主模型失敗時的備援（實測 super 快但常 503，lightning 穩但慢）
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ── 地端模型（Ollama / LM Studio / llama.cpp）──
# 不需要 API key。切換時把上面的 LLM_PROVIDER 改成 local。
#   Ollama      http://localhost:11434/v1
#   LM Studio   http://localhost:1234/v1
#   llama.cpp   http://localhost:8080/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=

# ── Anthropic（之後要比較時才需要）──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# NIM 會間歇回 503，重試次數比預設高
LLM_MAX_RETRIES=5
# reasoning 模型需要足夠的輸出預算，太小會讓推理截斷並洩漏進回覆
LLM_MAX_OUTPUT_TOKENS=8000

PORT=3000

# ── 資料庫（對應 infra/compose 的 postgres 服務）──
DATABASE_URL=postgres://movequest:movequest@localhost:5432/movequest
