# 複製成 .env 後填入。.env 已被 git 忽略，不會被提交。

# 要用哪一家：nvidia | anthropic
LLM_PROVIDER=nvidia

# ── NVIDIA NIM ──
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 必填，沒有預設值。去 build.nvidia.com 看目前可用的模型，
# 複製它頁面上的 model id 貼過來（形如 meta/llama-... 或 nvidia/... ）。
NVIDIA_MODEL=

# ── Anthropic（之後要比較時才需要）──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

PORT=3000
